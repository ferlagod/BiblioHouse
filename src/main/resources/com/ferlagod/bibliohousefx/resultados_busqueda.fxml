<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox minHeight="400.0" minWidth="600.0" prefHeight="400.0" prefWidth="600.0" spacing="10.0"  xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ferlagod.bibliohousefx.ResultadosBusquedaController">
   <children>
      <Label styleClass="heading-text" text="Resultados de la búsqueda" />
      <Label text="Selecciona el libro que quieres importar:" />
      
      <TableView fx:id="tablaResultados" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colTitulo" prefWidth="250.0" text="Título" />
          <TableColumn fx:id="colAutor" prefWidth="150.0" text="Autor" />
            <TableColumn fx:id="colAnio" prefWidth="75.0" text="Año" />
            <TableColumn fx:id="colEditorial" prefWidth="100.0" text="Editorial" />
        </columns>
      </TableView>
      
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Button cancelButton="true" onAction="#cancelar" text="Cancelar" />
            <Button defaultButton="true" onAction="#seleccionar" styleClass="google-button" text="Seleccionar Libro" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
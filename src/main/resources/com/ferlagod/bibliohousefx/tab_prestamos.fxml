<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" styleClass="content-area" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ferlagod.bibliohousefx.PrestamosController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label styleClass="heading-text" text="%loans.management" />
        <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="input-panel">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <VBox spacing="2.0">
                    <Label style="-fx-font-size: 10px; -fx-text-fill: #666;" text="%loans.book" />
                    <ComboBox fx:id="comboLibrosPrestamo" prefWidth="250.0" promptText="%loans.book.placeholder" />
                </VBox>
                <VBox spacing="2.0">
                    <Label style="-fx-font-size: 10px; -fx-text-fill: #666;" text="%loans.member" />
                    <ComboBox fx:id="comboSocios" prefWidth="200.0" promptText="%loans.member.placeholder" />
                </VBox>
                <Button onAction="#nuevoSocio" style="-fx-min-width: 30px;" text="+">
                    <tooltip>
                        <Tooltip text="%loans.new_member.tooltip" />
                    </tooltip>
                </Button>
                <Button onAction="#gestionarSocios" text="%loans.manage_members" />
                <Separator orientation="VERTICAL" />
                <Button onAction="#realizarPrestamo" styleClass="google-button" text="%loans.action" />
            </children>
        </HBox>
        <TableView fx:id="tablaPrestamos" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colPrestamoLibro" prefWidth="250.0" text="%col.loan.book" />
                <TableColumn fx:id="colPrestamoSocio" prefWidth="200.0" text="%col.loan.member" />
                <TableColumn fx:id="colPrestamoFecha" prefWidth="120.0" text="%col.loan.date" />
                <TableColumn fx:id="colPrestamoDevolucion" prefWidth="120.0" text="%col.loan.return" />
            </columns>
        </TableView>
        <HBox alignment="CENTER_RIGHT">
            <children>
                <Button onAction="#marcarDevuelto" text="%loans.return_action" />
            </children>
        </HBox>
    </children>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.web.WebView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<BorderPane prefWidth="900.0" prefHeight="700.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ferlagod.bibliohousefx.LectorDigitalController">
    <top>
        <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-background-color: -color-bg-subtle; -fx-padding: 10; -fx-border-color: -color-border-default; -fx-border-width: 0 0 1 0;">
            <children>
                <Label fx:id="lblTituloLector" text="%book.title.default" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                <Region HBox.hgrow="ALWAYS" />
                <Button text="%reader.font.decrease" onAction="#disminuirLetra" />
                <Button text="%reader.font.increase" onAction="#aumentarLetra" />
                <Label text="|" style="-fx-text-fill: -color-fg-muted;"/>
                <Button text="%reader.prev" onAction="#paginaAnterior" />
                <Button text="%reader.next" onAction="#paginaSiguiente" />
            </children>
        </HBox>
    </top>
    <center>
        <WebView fx:id="webViewLector" />
    </center>
    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: -color-bg-default; -fx-padding: 5; -fx-border-color: -color-border-default; -fx-border-width: 1 0 0 0;">
            <children>
                <Label fx:id="lblProgreso" text="%reader.progress.default" style="-fx-text-fill: -color-fg-muted;"/>
            </children>
        </HBox>
    </bottom>
</BorderPane>

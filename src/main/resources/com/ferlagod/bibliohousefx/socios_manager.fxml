<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="700.0" spacing="15.0" style="-fx-background-color: white;"  xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ferlagod.bibliohousefx.SociosManagerController">
    <children>
        <Label styleClass="heading-text" text="Gestión de Socios" />
        <Separator />
        
        <Label text="Lista de todos los socios registrados:" textFill="#5f6368" />

        <TableView fx:id="tablaSocios" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNumero" prefWidth="80.0" text="Nº Socio" />
                <TableColumn fx:id="colNombre" prefWidth="150.0" text="Nombre" />
                <TableColumn fx:id="colApellidos" prefWidth="200.0" text="Apellidos" />
                <TableColumn fx:id="colDni" prefWidth="120.0" text="DNI" />
                <TableColumn fx:id="colDomicilio" prefWidth="150.0" text="Domicilio" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button onAction="#editarSocio" text="Editar Seleccionado" />
                <Button onAction="#eliminarSocio" styleClass="danger-button" text="Eliminar Socio" />
                <Separator orientation="VERTICAL" />
                <Button cancelButton="true" onAction="#cerrarVentana" text="Cerrar" />
            </children>
        </HBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
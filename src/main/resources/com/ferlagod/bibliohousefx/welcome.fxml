<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" minHeight="450.0" minWidth="320.0" prefHeight="450.0" prefWidth="320.0" spacing="20.0" styleClass="login-card" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ferlagod.bibliohousefx.WelcomeController">
    <children>
        <ImageView fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../../../resources/LogoBiblioHouse.png" />
            </image>
        </ImageView>
        
        <Label styleClass="heading-text" text="%welcome.title" />
        <Label styleClass="subheading-text" text="%welcome.subtitle" wrapText="true" textAlignment="CENTER" />
        
        <VBox alignment="CENTER" spacing="15.0" style="-fx-padding: 20 0 0 0;">
            <Button mnemonicParsing="false" onAction="#iniciarConRegistro" prefWidth="250.0" styleClass="google-button" text="%welcome.btn.register" />
            <Button mnemonicParsing="false" onAction="#iniciarSinRegistro" prefWidth="250.0" styleClass="text-button" style="-fx-border-color: -color-border; -fx-border-radius: 3px;" text="%welcome.btn.guest" />         
        </VBox>
    </children>
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
</VBox>

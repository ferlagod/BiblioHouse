<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="240.0" spacing="15.0" styleClass="sidebar" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ferlagod.bibliohousefx.SidebarController">
    <children>
        <Label style="-fx-font-weight: bold; -fx-padding: 0 0 10 0;" text="Mis Estanterías" />
        <ListView fx:id="listaEstanterias" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS" />
        
        <!-- Widget de Reto Anual -->
        <VBox fx:id="widgetRetoAnual" spacing="8.0" style="-fx-padding: 15; -fx-background-color: -color-bg-subtle; -fx-background-radius: 10; -fx-border-color: -color-border-default; -fx-border-radius: 10; -fx-cursor: hand;" onMouseClicked="#configurarRetoAnual">
            <Label fx:id="lblTituloReto" text="Reto de Lectura" style="-fx-font-weight: bold; -fx-font-size: 13px;" />
            <ProgressBar fx:id="progresoReto" progress="0.0" prefWidth="200.0" style="-fx-accent: #4caf50;" />
            <Label fx:id="lblEstadoReto" text="0 de 0 libros" style="-fx-font-size: 11px; -fx-text-fill: -color-fg-muted;" />
        </VBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>

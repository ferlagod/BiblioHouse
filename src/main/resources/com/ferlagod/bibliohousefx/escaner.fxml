<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox alignment="CENTER" spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ferlagod.bibliohousefx.EscanerController" style="-fx-padding: 20;">
    <children>
        <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Escáner de Código de Barras" />
        <Label text="Apunta el código de barras a la cámara" />
        
        <ImageView fx:id="imgWebcam" fitHeight="240.0" fitWidth="320.0" pickOnBounds="true" preserveRatio="true" style="-fx-border-color: #ccc; -fx-border-width: 2px;" />
        
        <HBox alignment="CENTER" spacing="10.0">
             <Button onAction="#cancelar" text="Cancelar" cancelButton="true" />
        </HBox>
    </children>
</VBox>
